# Local file storage (existing image/thumbnail workflow)
STORAGE_DIR=data/storage
DB_FILE=data/db.json
THUMBNAILS_DIR=data/thumbnails

# MongoDB
# Local dev, e.g. a MongoDB running in Docker:
#   MONGODB_URI=mongodb://localhost:27017
# DigitalOcean managed MongoDB (get the real URI from the DO control panel):
#   MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/admin?tls=true&authSource=admin
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=image_thumbnail_db
